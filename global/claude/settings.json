{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.development)",
      "Read(**/.env.testing)",
      "Read(**/.env.test)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/guard-bash.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/stall-watch.sh\"",
            "asyncRewake": true,
            "timeout": 14400
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "skills@swmansion": true
  },
  "extraKnownMarketplaces": {
    "swmansion": {
      "source": {
        "source": "github",
        "repo": "software-mansion-labs/skills"
      }
    }
  }
}
