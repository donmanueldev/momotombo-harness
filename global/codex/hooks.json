{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/guard-bash.sh\"",
            "timeout": 10,
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/comment-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for new comments"
          }
        ]
      }
    ]
  }
}
