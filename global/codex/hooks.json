{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/guard-bash.sh\"",
            "timeout": 10,
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ]
  }
}
