#!/usr/bin/env bats
# Tests for `harness init` (project layer). openspec and npx are stubbed so the suite runs offline.

setup() {
    PROJECT_DIR="$(cd "$BATS_TEST_DIRNAME/.." && pwd)"
    TEST_TMP="$(cd "$(mktemp -d)" && pwd -P)"
    APP="$TEST_TMP/shop"
    STUBS="$TEST_TMP/stubs"
    mkdir -p "$APP" "$STUBS"
    git -C "$APP" init -q

    cat > "$STUBS/openspec" <<'SH'
#!/bin/bash
echo "openspec $*" >> "$STUB_LOG"
mkdir -p openspec/specs openspec/changes .agents/skills/openspec-propose
printf 'schema: spec-driven\n\n# context: |\n#   example\n' > openspec/config.yaml
SH
    cat > "$STUBS/npx" <<'SH'
#!/bin/bash
echo "npx $*" >> "$STUB_LOG"
for skill in codely-doc-create codely-openspec-spec-create-from-code; do
    mkdir -p ".agents/skills/$skill" && echo "---" > ".agents/skills/$skill/SKILL.md"
done
SH
    chmod +x "$STUBS/openspec" "$STUBS/npx"
    export STUB_LOG="$TEST_TMP/stub.log"
    export PATH="$STUBS:$PATH"
}

teardown() {
    rm -rf "$TEST_TMP"
}

init() {
    "$PROJECT_DIR/bin/harness" init "$APP" "$@"
}

laravel_app() {
    echo '{"require": {"laravel/framework": "^12.0"}}' > "$APP/composer.json"
    echo '{"scripts": {"build": "vite build", "lint": "eslint ."}}' > "$APP/package.json"
}

@test "init detects Laravel and seeds its docs, AGENTS.md, and CLAUDE.md" {
    laravel_app
    run init
    [[ "$status" -eq 0 ]] || return 1
    [[ "$output" == *"stack: laravel"* ]] || return 1
    [[ -f "$APP/docs/backend/thin-controllers-and-actions.md" ]] || return 1
    [[ -f "$APP/docs/testing/pest-feature-tests.md" ]] || return 1
    [[ ! -e "$APP/docs/mobile" ]] || return 1
    [[ "$(readlink "$APP/CLAUDE.md")" == "AGENTS.md" ]] || return 1
    grep -q 'php artisan test' "$APP/AGENTS.md" || return 1
    grep -q 'package.json scripts: `build`, `lint`' "$APP/AGENTS.md" || return 1
    grep -q '(docs/backend/form-requests-and-policies.md)' "$APP/AGENTS.md" || return 1
}

@test "init names the project's check script in AGENTS.md, with the lockfile's runner" {
    echo '{"scripts": {"check": "tsc && jest"}}' > "$APP/package.json"
    for pair in "bun.lock:bun run check" "pnpm-lock.yaml:pnpm run check" "yarn.lock:yarn run check" ":npm run check"; do
        rm -f "$APP/AGENTS.md" "$APP/bun.lock" "$APP/pnpm-lock.yaml" "$APP/yarn.lock"
        [[ -z "${pair%%:*}" ]] || touch "$APP/${pair%%:*}"
        run init --no-codely
        grep -qF "**Check:** \`${pair#*:}\`" "$APP/AGENTS.md" || { echo "$pair"; return 1; }
    done
}

@test "with check scripts in composer.json and package.json, AGENTS.md names both" {
    echo '{"require": {"laravel/framework": "^12.0"}, "scripts": {"check": "@test"}}' > "$APP/composer.json"
    echo '{"scripts": {"check": "tsc"}}' > "$APP/package.json"
    run init --no-codely
    grep -qF '**Check:** `composer check && npm run check`' "$APP/AGENTS.md" || return 1
}

@test "the generated AGENTS.md lists the dependency audit picked by the lockfile" {
    echo '{"scripts": {"check": "tsc && jest"}}' > "$APP/package.json"
    for pair in "bun.lockb:bun audit" "pnpm-lock.yaml:pnpm audit" "yarn.lock:yarn audit" "yarn.lock .yarnrc.yml:yarn npm audit" ":npm audit"; do
        rm -f "$APP/AGENTS.md" "$APP/bun.lockb" "$APP/pnpm-lock.yaml" "$APP/yarn.lock" "$APP/.yarnrc.yml"
        for file in ${pair%%:*}; do touch "$APP/$file"; done
        run init --no-codely
        grep -qE "^${pair#*:} +# known-vulnerable dependencies$" "$APP/AGENTS.md" || { echo "$pair"; return 1; }
    done
    grep -qF 'runs every check (tests, types, lint, format, dependency audit)' "$APP/AGENTS.md" || return 1
}

@test "a yarn.lock with __metadata is Yarn Berry even without .yarnrc.yml" {
    echo '{"scripts": {"check": "tsc"}}' > "$APP/package.json"
    printf '# This file is generated by running "yarn install"\n\n__metadata:\n  version: 8\n' > "$APP/yarn.lock"
    run init --no-codely
    grep -qE '^yarn npm audit +# known-vulnerable dependencies$' "$APP/AGENTS.md" || return 1
    [[ "$output" == *'add `yarn npm audit` to it'* ]] || return 1
}

@test "with composer.json and package.json, AGENTS.md audits both" {
    echo '{"require": {"laravel/framework": "^12.0"}, "scripts": {"check": "@test"}}' > "$APP/composer.json"
    echo '{"scripts": {"check": "tsc"}}' > "$APP/package.json"
    run init --no-codely
    grep -qE '^composer audit && npm audit +# known-vulnerable dependencies$' "$APP/AGENTS.md" || return 1
}

@test "without a check script, the AGENTS.md TODO names the audit to include" {
    laravel_app
    run init --no-codely
    grep -qF 'that runs the tests, types, lint, format, and dependency audit (`composer audit && npm audit`)' "$APP/AGENTS.md" || return 1
}

@test "without manifests, AGENTS.md has no audit line" {
    run init --no-codely
    [[ "$status" -eq 0 ]] || return 1
    ! grep -q 'known-vulnerable dependencies' "$APP/AGENTS.md" || return 1
}

@test "init warns when a check script doesn't audit dependencies, naming the audit to add" {
    echo '{"scripts": {"check": "tsc && jest"}}' > "$APP/package.json"
    touch "$APP/yarn.lock" "$APP/.yarnrc.yml"
    run init --no-codely
    [[ "$output" == *'package.json'\''s check script doesn'\''t seem to audit dependencies; add `yarn npm audit` to it'* ]] || return 1
    echo '{"scripts": {"check": "tsc && jest && yarn npm audit"}}' > "$APP/package.json"
    run init --no-codely
    [[ "$output" != *"doesn't seem to audit"* ]] || return 1
}

@test "the audit warning reads composer check scripts written as a string or a list" {
    echo '{"scripts": {"check": "@test"}}' > "$APP/composer.json"
    run init --no-codely
    [[ "$output" == *'composer.json'\''s check script doesn'\''t seem to audit dependencies; add `composer audit` to it'* ]] || return 1
    echo '{"scripts": {"check": ["@test", "@lint"]}}' > "$APP/composer.json"
    run init --no-codely
    [[ "$output" == *"composer.json's check script doesn't seem to audit"* ]] || return 1
    echo '{"scripts": {"check": ["@test", "composer audit"]}}' > "$APP/composer.json"
    run init --no-codely
    [[ "$output" != *"doesn't seem to audit"* ]] || return 1
    echo '{"scripts": {"check": "@test && composer audit"}}' > "$APP/composer.json"
    run init --no-codely
    [[ "$output" != *"doesn't seem to audit"* ]] || return 1
}

@test "init asks for a check script when there is none, even with a broken package.json" {
    laravel_app
    echo '{ not json' > "$APP/package.json"
    run init --no-codely
    [[ "$status" -eq 0 ]] || return 1
    grep -q 'TODO: add one `check` script' "$APP/AGENTS.md" || return 1
    [[ "$output" == *"no 'check' script"* ]] || return 1
}

@test "on a repo with its own AGENTS.md, init flags a check command it doesn't name" {
    echo '{"require": {"laravel/framework": "^12.0"}, "scripts": {"check": "@test"}}' > "$APP/composer.json"
    echo 'Run `composer check-platform-reqs` first.' > "$APP/AGENTS.md"
    run init --no-codely
    [[ "$output" == *'AGENTS.md doesn'\''t name the check command. Add: **Check:** `composer check`'* ]] || return 1
    echo '**Check:** `composer check`' >> "$APP/AGENTS.md"
    run init --no-codely
    [[ "$output" != *"doesn't name the check command"* ]] || return 1
}

@test "with Laravel Boost, a check command named in a guideline counts" {
    echo '{"require": {"laravel/framework": "^12.0"}, "scripts": {"check": "@test"}}' > "$APP/composer.json"
    echo '{"agents": ["claude_code"]}' > "$APP/boost.json"
    echo "<laravel-boost-guidelines>x</laravel-boost-guidelines>" > "$APP/AGENTS.md"
    mkdir -p "$APP/.ai/guidelines"
    echo 'Run `composer check` before finishing.' > "$APP/.ai/guidelines/checks.md"
    run init --no-codely
    [[ "$output" != *"doesn't name the check command"* ]] || return 1
}

@test "init detects Expo and seeds only mobile docs" {
    echo '{"dependencies": {"expo": "~55.0.0"}}' > "$APP/package.json"
    run init
    [[ "$output" == *"stack: expo"* ]] || return 1
    [[ -f "$APP/docs/mobile/expo-router-screens.md" ]] || return 1
    [[ -f "$APP/docs/mobile/native-config-and-permissions.md" && -f "$APP/docs/mobile/server-and-client-state.md" ]] || return 1
    grep -q "docs/mobile/server-and-client-state.md" "$APP/AGENTS.md" || return 1
    [[ ! -e "$APP/docs/backend" ]] || return 1
    grep -q 'npx expo start' "$APP/AGENTS.md" || return 1
}

@test "--stack overrides detection and rejects unknown stacks" {
    run init --stack laravel,expo
    [[ -f "$APP/docs/backend/form-requests-and-policies.md" && -f "$APP/docs/mobile/secure-storage-and-api.md" ]] || return 1
    run init --stack rails
    [[ "$status" -ne 0 ]] || return 1
    [[ "$output" == *"unknown stack 'rails'"* ]] || return 1
}

@test "init sets up OpenSpec with the momotombo schema and the Codely skills" {
    laravel_app
    run init
    grep -q 'openspec init --tools claude,codex' "$STUB_LOG" || return 1
    [[ -f "$APP/openspec/schemas/momotombo/schema.yaml" ]] || return 1
    grep -q '^schema: momotombo$' "$APP/openspec/config.yaml" || return 1
    grep -q 'skills@1.8.1 add CodelyTV/agent-harness --skill codely-doc-create --skill codely-openspec-spec-create-from-code -a claude-code -a codex -y' "$STUB_LOG" || return 1
}

@test "init never overwrites existing files and a re-run changes nothing" {
    laravel_app
    echo "# my agents" > "$APP/AGENTS.md"
    mkdir -p "$APP/docs/backend" "$APP/openspec"
    echo "mine" > "$APP/docs/backend/thin-controllers-and-actions.md"
    printf 'schema: spec-driven\ncontext: |\n  custom\n' > "$APP/openspec/config.yaml"

    run init
    [[ "$status" -eq 0 ]] || return 1
    grep -qx "# my agents" "$APP/AGENTS.md" || return 1
    grep -qx "mine" "$APP/docs/backend/thin-controllers-and-actions.md" || return 1
    grep -q 'custom' "$APP/openspec/config.yaml" || return 1
    [[ "$output" == *"set 'schema: momotombo'"* ]] || return 1
    ! grep -q 'openspec init' "$STUB_LOG" || return 1

    run init
    [[ "$output" != *"✓ "* ]] || return 1
    [[ "$(grep -c 'skills@' "$STUB_LOG")" -eq 1 ]] || return 1
}

@test "init refuses to merge a standalone CLAUDE.md" {
    echo "# old claude instructions" > "$APP/CLAUDE.md"
    run init --no-codely
    [[ "$output" == *"CLAUDE.md exists as its own file"* ]] || return 1
    grep -q "old claude instructions" "$APP/CLAUDE.md" || return 1
}

@test "dry run changes nothing" {
    laravel_app
    run init --dry-run
    [[ "$status" -eq 0 ]] || return 1
    [[ "$output" == *"[dry-run] would create AGENTS.md"* ]] || return 1
    [[ ! -e "$APP/AGENTS.md" && ! -e "$APP/docs" ]] || return 1
    [[ ! -e "$STUB_LOG" ]] || return 1
}

@test "dry run on a repo with its own AGENTS.md lists the docs map it should have" {
    laravel_app
    echo "# mine" > "$APP/AGENTS.md"
    mkdir -p "$APP/docs/backend"
    printf '# Thin controllers\n' > "$APP/docs/backend/thin-controllers.md"
    run init --dry-run
    [[ "$output" == *"Make sure its docs map lists these existing docs"* ]] || return 1
    [[ "$output" == *"- [Thin controllers](docs/backend/thin-controllers.md)"* ]] || return 1
}

@test "with Laravel Boost, init writes the docs map as a Boost guideline and keeps it" {
    laravel_app
    echo '{"agents": ["claude_code"], "guidelines": true}' > "$APP/boost.json"
    echo "<laravel-boost-guidelines>x</laravel-boost-guidelines>" > "$APP/AGENTS.md"
    run init --no-codely
    [[ "$status" -eq 0 ]] || return 1
    grep -qx '# Docs map' "$APP/.ai/guidelines/docs-map.md" || return 1
    grep -q '(docs/backend/form-requests-and-policies.md)' "$APP/.ai/guidelines/docs-map.md" || return 1
    [[ "$output" == *"php artisan boost:update"* ]] || return 1
    [[ "$output" != *"Make sure its docs map lists"* ]] || return 1
    grep -qx "<laravel-boost-guidelines>x</laravel-boost-guidelines>" "$APP/AGENTS.md" || return 1

    echo "custom" > "$APP/.ai/guidelines/docs-map.md"
    run init --no-codely
    grep -qx "custom" "$APP/.ai/guidelines/docs-map.md" || return 1
}

@test "dry run finishes on a repo with AGENTS.md and no docs folder" {
    laravel_app
    echo "# mine" > "$APP/AGENTS.md"
    run init --dry-run
    [[ "$status" -eq 0 ]] || { echo "$output"; return 1; }
    [[ "$output" == *"Run without --dry-run to apply."* ]] || return 1
}

@test "with Laravel Boost and no AGENTS.md, the docs map is written once, as the Boost guideline" {
    laravel_app
    echo '{"agents": ["claude_code"]}' > "$APP/boost.json"
    run init --no-codely
    [[ "$status" -eq 0 ]] || return 1
    grep -q '(docs/backend/form-requests-and-policies.md)' "$APP/.ai/guidelines/docs-map.md" || return 1
    ! grep -q '(docs/backend/form-requests-and-policies.md)' "$APP/AGENTS.md" || return 1
    grep -q '.ai/guidelines/docs-map.md' "$APP/AGENTS.md" || return 1
}

@test "with Laravel Boost, a dry run writes no guideline" {
    laravel_app
    echo '{"agents": ["claude_code"]}' > "$APP/boost.json"
    run init --dry-run
    [[ "$output" == *"would write .ai/guidelines/docs-map.md"* ]] || return 1
    [[ ! -e "$APP/.ai" ]] || return 1
}

@test "init doesn't flag a momotombo schema that a formatter only restyled" {
    laravel_app
    mkdir -p "$APP/openspec/schemas"
    cp -R "$PROJECT_DIR/project/openspec/schemas/momotombo" "$APP/openspec/schemas/momotombo"
    sed -i '' -e "s/\"/'/g" -e 's/^schema:/\nschema:/' "$APP/openspec/schemas/momotombo/schema.yaml"
    printf '\n\n' >> "$APP/openspec/schemas/momotombo/templates/spec.md"
    run init --no-codely
    [[ "$status" -eq 0 ]] || return 1
    [[ "$output" != *"differs from the harness"* ]] || { echo "$output"; return 1; }
}

@test "init refuses to run on the harness itself" {
    run "$PROJECT_DIR/bin/harness" init "$PROJECT_DIR"
    [[ "$status" -ne 0 ]] || return 1
}

@test "the momotombo schema and a change written from its templates pass OpenSpec strict validation" {
    real=$(PATH="${PATH#"$STUBS:"}" command -v openspec) || skip "openspec not installed"
    cd "$APP"
    export OPENSPEC_NO_UPDATE_CHECK=1 OPENSPEC_TELEMETRY=0 CI=true
    mkdir -p openspec/schemas openspec/changes/sample/specs/demo
    cp -R "$PROJECT_DIR/project/openspec/schemas/momotombo" openspec/schemas/
    cp "$PROJECT_DIR/project/openspec/config.yaml" openspec/config.yaml
    run "$real" schema validate momotombo
    [[ "$status" -eq 0 ]] || return 1
    sed -e 's/<!-- requirement name -->/Demo/' -e 's/<!-- one behaviour, in one or two sentences -->/show a demo/' \
        -e 's/<!-- action, with concrete values -->/the user opens the demo/' -e 's/<!-- observable outcome -->/the demo appears/' \
        -e '/^## Purpose/,/^## ADDED/{/^## ADDED/!d;}' \
        "$PROJECT_DIR/project/openspec/schemas/momotombo/templates/spec.md" > openspec/changes/sample/specs/demo/spec.md
    cp "$PROJECT_DIR/project/openspec/schemas/momotombo/templates/plan.md" openspec/changes/sample/plan.md
    run "$real" validate sample --strict
    [[ "$status" -eq 0 ]] || { echo "$output"; return 1; }
}

@test "init keeps a customized momotombo schema" {
    laravel_app
    mkdir -p "$APP/openspec/schemas/momotombo"
    echo "custom" > "$APP/openspec/schemas/momotombo/schema.yaml"
    run init --no-codely
    [[ "$status" -eq 0 ]] || return 1
    grep -qx "custom" "$APP/openspec/schemas/momotombo/schema.yaml" || return 1
    [[ "$output" == *"differs from the harness; left unchanged"* ]] || return 1
}
